<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>


<StackPane xmlns="http://javafx.com/javafx/23"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.personal.campusbookingsystem.controller.LoginController"
           prefWidth="1280.0"
           prefHeight="800.0"
           styleClass="background"
           stylesheets="@../css/style.css">


   <children>

      <VBox maxWidth="650"
            maxHeight="620"
            prefWidth="650"
            prefHeight="620"
            spacing="18"
            alignment="TOP_CENTER"
            styleClass="login-card">

         <padding>
            <Insets top="35" right="60" bottom="35" left="60"/>
         </padding>

         <children>

            <ImageView fitWidth="72" fitHeight="82" preserveRatio="true" smooth="true"
                       styleClass="brand-logo">
               <image>
                  <Image url="@../images/logo.png"/>
               </image>
            </ImageView>

            <Label text="UniReserve"
                   styleClass="title"/>

            <Label text="Welcome Back! Please login to your account."
                   styleClass="subtitle"/>

            <Label text="Email"
                   styleClass="field-label"/>

            <TextField fx:id="usernameField"
                       promptText="Enter your email"
                       prefHeight="45"
                       styleClass="text-field-custom"/>

            <Label text="Password"
                   styleClass="field-label"/>

            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           prefHeight="45"
                           styleClass="text-field-custom"/>

            <HBox alignment="CENTER_LEFT" spacing="10">

               <children>

                  <CheckBox text="Remember Me"
                            styleClass="remember-me"/>

                  <Region HBox.hgrow="ALWAYS"/>

                  <Hyperlink fx:id="forgotPasswordLink"
                             text="Forgot Password?"
                             styleClass="forgot-password"
                             onAction="#handleForgotPassword"/>

               </children>

            </HBox>

            <Label fx:id="errorLabel"
                   text=""
                   managed="false"
                   visible="false"
                   styleClass="error-text"/>

            <Button fx:id="loginButton"
                    text="Login"
                    prefHeight="45"
                    maxWidth="Infinity"
                    styleClass="login-button"
                    onAction="#handleLogin"/>

            <Label text="Role detected automatically based on your account."
                   styleClass="bottom-text"/>

         </children>
      </VBox>

   </children>

</StackPane>